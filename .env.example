# Copy to .env.local in the project root and fill in your Supabase values.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# Use a public anon or publishable key, never a service_role or secret key.
VITE_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key

# Existing NEXT_PUBLIC_SUPABASE_URL and NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
# values are still supported. VITE_* values take precedence when provided.
# Restart npm run dev after changing .env.local.
